[Unit]
Description=Harpoon: check apps for new releases

[Service]
Type=oneshot
# Started through the app launcher so that harpoon-autoupdate gets the
# privileged group from privileges.d (silent PackageKit installs). Without
# the launcher, fall back to a plain check.
ExecStart=/bin/sh -c 'if [ -x /usr/bin/invoker ]; then exec /usr/bin/invoker --type=generic /usr/bin/harpoon-autoupdate; else exec /usr/bin/harpoon-cli check --notify --quiet; fi'
Nice=10
